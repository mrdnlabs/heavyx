__pycache__/
*.pyc
venv/
.env

# datasets and heavy/generated artifacts stay out of git
datasets/
runs/
third_party/
vendor/

# models/ holds large trained weights AND local test snapshots (some private) —
# exclude entirely. The shippable ACAP package is under acap/.../build/ instead.
models/

# GPU health telemetry
gpu_health.csv

# ACAP build trees: eaps are distributed via GitHub Releases, never committed
acap/**/build/
legacy/**/build/

# EXCEPTION (deliberate): acap/heavyx/app/model/model.tflite (~21 MB) IS
# committed — the Docker build requires it in-tree and quantization constants
# are extracted from it at build time. models/ below stays ignored.

# app/lib/*.so* are required link inputs for the ACAP build — never ignore
!acap/heavyx/app/lib/*.so*

# local secrets / per-machine config
steering/config.yaml

# harness/runtime state
.claude/
